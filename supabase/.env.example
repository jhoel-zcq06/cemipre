# Variables y secretos para Supabase Edge Functions (configurar vía `supabase secrets set` o Dashboard)
# NUNCA subir valores reales a Git.

# JSON completo de la Service Account de Google Cloud (una sola línea o stringificado)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","token_uri":"https://oauth2.googleapis.com/token"}

# ID de la carpeta raíz compartida en Google Drive con los usuarios/bitácoras de CEMIPRE
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Puente opcional de Google Apps Script para crear carpetas y Docs desde cuentas @gmail.com personales
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Proveedor de IA: 'gemini' (recomendado) o 'openai'
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Proveedor de correo para notificaciones ('resend' o 'webhook')
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=CEMIPRE Bitácoras <notificaciones@tudominio.cl>
EMAIL_WEBHOOK_URL=

# Secreto compartido para proteger notificar-cambios (Cron / GitHub Actions)
CRON_SECRET=cambia-esto-por-un-secreto-aleatorio-largo

# Ventana en minutos para agrupar autoguardados de Google Docs y evitar spam
NOTIFY_DEBOUNCE_MINUTES=15

# URL pública de la plataforma (se incluye en los correos para abrir la app)
APP_BASE_URL=https://cemipre-plataforma.vercel.app
