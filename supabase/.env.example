# Variables y secretos para Supabase Edge Functions (configurar vía `supabase secrets set` o Dashboard)
# NUNCA subir valores reales a Git.

# --- Google OAuth 2.0 (Recomendado: acceso privado a Drive sin enlaces públicos y sincronización automática) ---
# Usa el mismo Client ID y Client Secret de Google Cloud configurados en Supabase Auth -> Providers -> Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Clave aleatoria larga (mínimo 32 caracteres) para cifrar los tokens OAuth en reposo con AES-256-GCM
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Opcional: por defecto se deriva como https://<PROJECT_REF>.supabase.co/functions/v1/google-drive-auth
GOOGLE_OAUTH_REDIRECT_URI=
# Opcional: orígenes extra permitidos para redirección OAuth separados por coma (ej.: previews de Vercel)
ALLOWED_RETURN_ORIGINS=

# --- Respaldo opcional: Service Account de Google Cloud ---
# Solo necesario si deseas mantener respaldo silencioso cuando no haya sesión OAuth institucional activa
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opcional: ID de carpeta raíz por defecto (también se puede seleccionar directamente desde la app en Carpetas Drive)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Opcional legado: puente Google Apps Script (ya no es necesario cuando hay cuenta Google OAuth conectada)
GOOGLE_DRIVE_WEBHOOK_URL=
GOOGLE_DRIVE_WEBHOOK_SECRET=

# Proveedor de IA: 'gemini' (recomendado) o 'openai'
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Proveedor de correo para notificaciones ('resend' o 'webhook')
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=CEMIPRE Bitácoras <notificaciones@tudominio.cl>
EMAIL_WEBHOOK_URL=

# Secreto compartido para proteger sync-drive automático y notificar-cambios (Cron / GitHub Actions)
CRON_SECRET=cambia-esto-por-un-secreto-aleatorio-largo

# Ventana en minutos para agrupar autoguardados de Google Docs y evitar spam
NOTIFY_DEBOUNCE_MINUTES=15

# URL pública de la plataforma (se usa en correos y redirección tras conectar Google Drive)
APP_BASE_URL=https://cemipre-plataforma.vercel.app
